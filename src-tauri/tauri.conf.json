{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZennTutor",
  "version": "../package.json",
  "identifier": "dev.zenntutor.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ZennTutor",
        "width": 1040,
        "height": 760,
        "minWidth": 720,
        "minHeight": 560,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNDOTNGNDMwMjM0NjJCMTIKUldRU0swWWpNUFNUUEJpLzIraXRXTEdlTU95aHpRRGR2R0lwaWd2SHZyZFg1SE1mRDBWRm1yZUIK",
      "endpoints": [
        "https://github.com/piasugoihito/zenn-tutor/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
